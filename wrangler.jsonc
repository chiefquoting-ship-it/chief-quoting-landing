{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiefquoting-landing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "chiefquoting.com", "custom_domain": true }
  ]
}
